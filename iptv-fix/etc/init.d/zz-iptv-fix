#!/bin/sh /etc/rc.common
# IPTV 桥接修正：
#  1) 关闭 IGMP snooping —— 内核 snooping 对"从 VLAN 子接口进来的 IGMP"
#     登记不上 MDB，导致组播不转发；关掉改成泛洪即可
#  2) 关闭组播 VLAN 端口的 MAC 学习 —— 否则组播流的源 MAC（网关）会被学在
#     ct-iptv-mc 上，机顶盒发往网关的单播包会被桥错误地转到组播 VLAN 并丢弃，
#     表现为 EPG/认证走不通、机顶盒卡在 85%
START=99
STOP=01

start() {
	# 等 br-iptv 与 VLAN 子接口就绪
	i=0
	while [ $i -lt 30 ]; do
		[ -d /sys/class/net/br-iptv/brif/ct-iptv-mc ] && break
		i=$((i+1)); sleep 1
	done
	[ -d /sys/class/net/br-iptv ] || return 0

	echo 0 > /sys/class/net/br-iptv/bridge/multicast_snooping 2>/dev/null
	bridge link set dev ct-iptv-mc learning off 2>/dev/null
	bridge link set dev ct-iptv-mc mcast_flood on 2>/dev/null
	logger -t iptv-fix "snooping=0, ct-iptv-mc learning off applied"
}

boot() { start "$@"; }

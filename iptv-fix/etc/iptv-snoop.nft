table bridge iptv_snoop {
	set subs {
		type ipv4_addr
		flags timeout
	}
	chain grpfilter {
		type filter hook forward priority 10; policy accept;
		iifname "ct-iptv-mc" oifname "lan3" ip protocol igmp accept
		iifname "ct-iptv-mc" oifname "lan3" ip daddr 224.0.0.1 accept
		iifname "ct-iptv-mc" oifname "lan3" ip daddr 239.255.255.250 accept
		iifname "ct-iptv-mc" oifname "lan3" ip daddr @subs counter accept
		iifname "ct-iptv-mc" oifname "lan3" ip daddr 224.0.0.0/4 counter drop
	}
}
